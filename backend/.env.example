# Local development
RITMO_DEBUG=true
DATABASE_URL=sqlite:///./ritmo.db
TIMEZONE=America/Sao_Paulo
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# Local SQLite development may explicitly disable access protection. Remove
# this opt-out and set APP_ACCESS_TOKEN in every shared or deployed environment.
ALLOW_INSECURE_NO_ACCESS_TOKEN=true
APP_ACCESS_TOKEN=
# When a token is set, every /api request must send X-Ritmo-Key: the-same-secret.
AUTH_MAX_FAILURES=10
AUTH_FAILURE_WINDOW_SECONDS=60
AUTH_LOCKOUT_SECONDS=300

# Optional error reporting. Create a separate Sentry project for the backend.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# Optional: enables real Web Push reminders, including when the installed PWA
# is closed. Keep the private key only in the backend environment.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# The single API replica runs the durable scheduler by default. Set false only
# when operating the optional external worker documented in DEPLOY.md.
PUSH_SCHEDULER_IN_API=true
PUSH_WORKER_POLL_SECONDS=60
PUSH_WORKER_BATCH_SIZE=100
PUSH_REMINDER_RECOVERY_HOURS=24
PUSH_DELIVERY_TTL_HOURS=72
PUSH_DELIVERY_MAX_ATTEMPTS=80
PUSH_RETRY_BASE_SECONDS=60
PUSH_RETRY_MAX_SECONDS=3600
PUSH_DELIVERY_RETENTION_DAYS=90

# Optional: enables the server-side ANAHÍ assistant. Never add this value to
# frontend variables or commit it to Git.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=15
ANAHI_RATE_LIMIT=20/minute

# Production requires RITMO_DEBUG=false, the insecure opt-out disabled, and a
# long random APP_ACCESS_TOKEN.
# Configure DATABASE_URL with the managed database connection string and list
# only the actual frontend origins (comma-separated or a JSON string array).
# RITMO_DEBUG=false
# ALLOW_INSECURE_NO_ACCESS_TOKEN=false
# APP_ACCESS_TOKEN=replace-with-a-long-random-secret
# CORS_ORIGINS=https://your-frontend.example
# DATABASE_URL=mysql+pymysql://user:password@host:3306/ritmo_db
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/ritmo_db
