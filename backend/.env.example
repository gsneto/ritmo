# Ritmo API — exemplo de configuração.
#
# Copie este arquivo para backend/.env e ajuste os valores.
# backend/.env é ignorado pelo Git; nunca versione valores reais.
#
# As variáveis refletem backend/config.py. Campos com validation_alias usam o
# nome exato abaixo; os demais recebem o prefixo RITMO_ (APP_NAME vira
# RITMO_APP_NAME). APP_ACCESS_TOKEN, DATABASE_URL, CORS_ORIGINS e TIMEZONE não
# levam prefixo.

# =============================================================================
# 1. Desenvolvimento local (SQLite)
# =============================================================================
# RITMO_DEBUG=true habilita o bootstrap do SQLite (create_all + ajustes de
# compatibilidade) e as rotas de documentação /docs, /redoc e /openapi.json.
RITMO_DEBUG=true

# Fixtures de demonstração (dois perfis + treinos padrão). Desligado por padrão.
# Nunca é ativado implicitamente: staging e produção não devem criar perfis sem
# senha. Ative apenas em um banco local descartável.
RITMO_SEED_DEFAULT_DATA=false

# Caminho relativo ao diretório backend/. É o banco usado no desenvolvimento.
# Atenção: backend/ritmo.db é também o banco legado descrito em STATUS.md. Com
# RITMO_DEBUG=true, iniciar a API executa o bootstrap de compatibilidade e o seed
# nesse arquivo. Para manter o legado intocado, use outro nome, por exemplo
# sqlite:///./ritmo-dev.db.
DATABASE_URL=sqlite:///./ritmo.db

TIMEZONE=America/Sao_Paulo
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# Sem APP_ACCESS_TOKEN a API aceita qualquer requisição. Isso só é permitido
# quando RITMO_DEBUG=true e o banco é SQLite. Nunca use em ambiente publicado.
ALLOW_INSECURE_NO_ACCESS_TOKEN=true
APP_ACCESS_TOKEN=

# Com APP_ACCESS_TOKEN definido, toda chamada /api exige o header X-Ritmo-Key
# com o mesmo valor. Esse é o caminho para scripts e backups, não para o
# navegador: o frontend usa sessão em cookie.
AUTH_MAX_FAILURES=10
AUTH_FAILURE_WINDOW_SECONDS=60
AUTH_LOCKOUT_SECONDS=300

# Sessão do navegador. O cookie é HttpOnly e o token CSRF é um segundo cookie
# legível, ambos ligados à mesma linha em user_sessions.
# SESSION_COOKIE_SECURE=false só é aceitável em http://localhost.
SESSION_TTL_HOURS=720
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax

# =============================================================================
# 2. Testes automatizados
# =============================================================================
# Nenhuma variável é obrigatória para `pytest`. tests/conftest.py cria um
# SQLite temporário em tmp_path, define APP_ACCESS_TOKEN=test-ritmo-key e ignora
# este arquivo (_env_file=None). A suíte liga SEED_DEFAULT_DATA porque usa os
# dois perfis como fixtures. tests/test_migrations.py ajusta DATABASE_URL e
# RITMO_DEBUG por monkeypatch. Não aponte os testes para backend/ritmo.db nem
# para um banco remoto.

# =============================================================================
# 3. Produção / ambiente publicado (referência — não use localmente)
# =============================================================================
# RITMO_DEBUG=false
# ALLOW_INSECURE_NO_ACCESS_TOKEN=false
# APP_ACCESS_TOKEN=<segredo-longo-e-aleatorio>
# DATABASE_URL=postgresql://usuario:senha@host:5432/ritmo?sslmode=require
# CORS_ORIGINS=https://<seu-frontend>
# SENTRY_ENVIRONMENT=production
# SESSION_COOKIE_SECURE=true
# SESSION_COOKIE_SAMESITE=lax
# Nunca habilite RITMO_SEED_DEFAULT_DATA em produção.
#
# Use SESSION_COOKIE_SAMESITE=none somente se o frontend e a API estiverem em
# sites diferentes. Nesse caso SESSION_COOKIE_SECURE precisa ser true, e o
# navegador passa a depender de cookies de terceiros. O caminho recomendado é
# servir a API na mesma origem do frontend (proxy), como descreve
# docs/ADR-AUTH-WEB.md.
#
# As senhas dos perfis são definidas por um operador com
# `python -m scripts.set_profile_password --profile-id <perfil>`. Não existe
# cadastro público e nenhuma senha padrão.
#
# A aplicação converte postgres:// e postgresql:// em postgresql+psycopg://.
# Não use SQLite em instância publicada com sistema de arquivos efêmero.

# =============================================================================
# Opcionais
# =============================================================================
# Sentry do backend. Deixe vazio para desativar.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# Web Push. As duas chaves VAPID devem ser configuradas juntas.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Scheduler durável embutido na API. Mantenha true com uma única réplica.
PUSH_SCHEDULER_IN_API=true
PUSH_WORKER_POLL_SECONDS=60
PUSH_WORKER_BATCH_SIZE=100
PUSH_REMINDER_RECOVERY_HOURS=24
PUSH_DELIVERY_TTL_HOURS=72
PUSH_DELIVERY_MAX_ATTEMPTS=80
PUSH_RETRY_BASE_SECONDS=60
PUSH_RETRY_MAX_SECONDS=3600
PUSH_DELIVERY_RETENTION_DAYS=90

# ANAHÍ (Google Gemini). A chave fica somente no backend; nunca use VITE_*.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=15
ANAHI_RATE_LIMIT=20/minute

# Fallback legado MySQL, usado apenas quando DATABASE_URL está vazio.
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=
# DB_NAME=ritmo_db
#
# DATABASE_URL_SYNC é aceita como alternativa quando DATABASE_URL está vazia.
